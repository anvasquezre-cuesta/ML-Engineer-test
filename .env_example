DOC_INTEL_APP_NAME=Document Intelligence Service
DOC_INTEL_LOG_LEVEL=INFO

# Upload validation
DOC_INTEL_MAX_UPLOAD_SIZE_MB=20
DOC_INTEL_MAX_NAMES_PER_REQUEST=1000

# OCR
DOC_INTEL_OCR_DPI=300
DOC_INTEL_OCR_LANGUAGE=eng
DOC_INTEL_OCR_TIMEOUT_SECONDS=60
DOC_INTEL_OCR_MIN_CONFIDENCE=0.30

# Person extraction and matching
DOC_INTEL_NER_MODEL_NAME=en_core_web_sm
DOC_INTEL_FUZZY_MATCH_THRESHOLD=0.90
DOC_INTEL_BBOX_MATCH_THRESHOLD=0.80
DOC_INTEL_BBOX_MAX_HORIZONTAL_GAP_FACTOR=3.0
