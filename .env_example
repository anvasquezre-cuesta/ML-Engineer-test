DOC_INTEL_APP_NAME=Document Intelligence Service
DOC_INTEL_LOG_LEVEL=INFO

# Docker Compose (development defaults only; replace the password outside local use)
API_PORT=8000
POSTGRES_DB=document_intelligence
POSTGRES_USER=doc_intel
POSTGRES_PASSWORD=doc_intel_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Upload validation
DOC_INTEL_MAX_UPLOAD_SIZE_MB=20
DOC_INTEL_MAX_NAMES_PER_REQUEST=1000

# OCR
DOC_INTEL_OCR_DPI=300
DOC_INTEL_OCR_LANGUAGE=eng
DOC_INTEL_OCR_TIMEOUT_SECONDS=60
DOC_INTEL_OCR_MIN_CONFIDENCE=0.30

# Person extraction and matching
DOC_INTEL_NER_MODEL_NAME=en_core_web_sm
DOC_INTEL_FUZZY_MATCH_THRESHOLD=0.90
DOC_INTEL_BBOX_MATCH_THRESHOLD=0.80
DOC_INTEL_BBOX_MAX_HORIZONTAL_GAP_FACTOR=3.0

# OpenAI API key (embeddings and OpenAI answer models selected through LiteLLM)
OPENAI_API_KEY=you-api-key
DOC_INTEL_EMBEDDING_MODEL_NAME=text-embedding-3-small
DOC_INTEL_EMBEDDING_DIMENSIONS=1536
DOC_INTEL_VECTOR_STORE_TABLE_NAME=document_chunks
DOC_INTEL_VECTOR_STORE_CONNECT_TIMEOUT_SECONDS=5
DOC_INTEL_VECTOR_STORE_STATEMENT_TIMEOUT_MS=10000
DOC_INTEL_VECTOR_STORE_MAX_RETRIES=2
DOC_INTEL_VECTOR_STORE_RETRY_DELAY_SECONDS=0.25
DOC_INTEL_RETRIEVAL_CANDIDATE_COUNT=10

# Local cross-encoder reranking (runs without an API key)
DOC_INTEL_RERANKER_MODEL_NAME=ms-marco-MiniLM-L-12-v2
DOC_INTEL_RERANKER_CACHE_DIR=.cache/flashrank
DOC_INTEL_RERANKER_MAX_LENGTH=512
DOC_INTEL_SELECTED_CANDIDATE_COUNT=5
DOC_INTEL_EVIDENCE_MIN_RELEVANCE_SCORE=0.0001

# Answer generation uses LiteLLM; change this value to switch provider/model.
# Examples: openai/gpt-5-mini, deepseek/deepseek-chat, minimax/MiniMax-M2.1
DOC_INTEL_LLM_MODEL_NAME=deepseek/deepseek-chat
DOC_INTEL_LLM_TEMPERATURE=0.0
DOC_INTEL_LLM_MAX_TOKENS=512
DOC_INTEL_LLM_TIMEOUT_SECONDS=60
DOC_INTEL_LLM_MAX_RETRIES=2

# Provider credentials read automatically by LiteLLM
# === MiniMax ===
MINIMAX_API_KEY=your-api-key
MINIMAX_API_BASE=https://api.minimax.io/v1
# === DEEPSEEK ===
DEEPSEEK_API_KEY=your-api-key
