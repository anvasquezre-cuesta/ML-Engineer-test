# Copy to .env and edit. Every value below is the default in app/core/config.py.
# Nested groups use a double underscore: OCR__DPI maps to settings.ocr.dpi.

LOG_LEVEL=INFO
LOG_JSON=true

# OCR (Tesseract via PyMuPDF rendering)
OCR__DPI=300
OCR__LANG=eng
OCR__PSM=3
OCR__PAGE_TIMEOUT_S=120
# Windows, when tesseract is not on PATH:
# OCR__TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# NER (spaCy)
NER__MODEL=en_core_web_lg
NER__PERSON_LABELS=["PERSON","PER"]

# Fuzzy matching
MATCHING__THRESHOLD=0.90

# RAG
RAG__CHUNK_WORDS=150
RAG__OVERLAP_WORDS=30
RAG__TOP_K=5
RAG__MIN_SIMILARITY=0.33
RAG__CONTEXT_MIN_SIMILARITY=0.30
RAG__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG__EMBEDDING_BATCH_SIZE=32
RAG__CHROMA_PATH=./data/chroma
RAG__COLLECTION=documents

# LLM (any OpenAI-compatible endpoint; default is a local Ollama)
LLM__BASE_URL=http://localhost:11434/v1
LLM__API_KEY=ollama
LLM__MODEL=llama3.2:1b
LLM__TIMEOUT_S=30
LLM__MAX_RETRIES=2
LLM__TEMPERATURE=0

# Upload limits
LIMITS__MAX_UPLOAD_BYTES=20971520
LIMITS__MAX_PAGES=50
