# local | aws
DOCINTEL_CLOUD_ENV=local

DOCINTEL_UPLOAD__MAX_BYTES=20971520
DOCINTEL_RENDER__DPI=300
DOCINTEL_OCR__LANGUAGES=eng
DOCINTEL_OCR__TIMEOUT_S=60
DOCINTEL_NER__MODEL=en_core_web_lg
DOCINTEL_MATCHER__THRESHOLD=0.9

# Characters; CHUNK_OVERLAP must be smaller than CHUNK_SIZE.
DOCINTEL_CHUNKING__CHUNK_SIZE=800
DOCINTEL_CHUNKING__CHUNK_OVERLAP=120

DOCINTEL_EMBEDDINGS__MODEL_NAME=BAAI/bge-small-en-v1.5
DOCINTEL_EMBEDDINGS__CACHE_DIR=.cache/fastembed
# true in the container: the model is baked in and never downloaded at startup.
DOCINTEL_EMBEDDINGS__LOCAL_FILES_ONLY=false
DOCINTEL_EMBEDDINGS__SPARSE_MODEL_NAME=Qdrant/bm25

DOCINTEL_QDRANT__URL=http://localhost:6333
DOCINTEL_QDRANT__API_KEY=
DOCINTEL_QDRANT__TOP_K=8
DOCINTEL_QDRANT__PREFETCH_LIMIT=100
DOCINTEL_QDRANT__RRF_K=60
DOCINTEL_QDRANT__CORPUS_IDF=true
# Retries are counted after the first attempt; DEADLINE_S bounds one operation.
DOCINTEL_QDRANT__TIMEOUT_S=5
DOCINTEL_QDRANT__MAX_RETRIES=2
DOCINTEL_QDRANT__DEADLINE_S=15

# PROVIDER: bedrock | openai. An empty MODEL uses the provider default.
# openai works with any OpenAI-compatible endpoint; an empty BASE_URL uses OpenAI.
DOCINTEL_LLM__PROVIDER=bedrock
DOCINTEL_LLM__BEDROCK_MODEL=us.amazon.nova-lite-v1:0
DOCINTEL_LLM__OPENAI_MODEL=gpt-6-luna
DOCINTEL_LLM__OPENAI_BASE_URL=
DOCINTEL_LLM__OPENAI_API_KEY=
DOCINTEL_LLM__AWS_REGION=us-east-1
DOCINTEL_LLM__AWS_PROFILE=
DOCINTEL_LLM__AWS_ACCESS_KEY_ID=
DOCINTEL_LLM__AWS_SECRET_ACCESS_KEY=
DOCINTEL_LLM__TIMEOUT_S=30
DOCINTEL_LLM__MAX_RETRIES=2
DOCINTEL_LLM__DEADLINE_S=60
DOCINTEL_LLM__TEMPERATURE=0
DOCINTEL_LLM__OPENAI_TEMPERATURE=
DOCINTEL_LLM__MAX_TOKENS=2048
DOCINTEL_LLM__REASONING_EFFORT=

# Defaults to the templates shipped in app/prompts.
DOCINTEL_PROMPTS__DIRECTORY=

# Empty keys disable tracing.
DOCINTEL_LLM_OBSERVABILITY__LANGFUSE_HOST=https://cloud.langfuse.com
DOCINTEL_LLM_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
DOCINTEL_LLM_OBSERVABILITY__LANGFUSE_SECRET_KEY=

# Empty ENDPOINT_URL and keys use AWS S3 and the task role.
DOCINTEL_BLOB__BUCKET=docintel
DOCINTEL_BLOB__ENDPOINT_URL=http://localhost:9000
DOCINTEL_BLOB__ACCESS_KEY_ID=minioadmin
DOCINTEL_BLOB__SECRET_ACCESS_KEY=minioadmin

DOCINTEL_QUEUE__RABBITMQ_URL=amqp://guest:guest@localhost:5672/
DOCINTEL_QUEUE__SQS_QUEUE_URL=
DOCINTEL_QUEUE__SQS_DEAD_LETTER_URL=

# DynamoDB Local; empty endpoint and keys use AWS and the task role.
DOCINTEL_DYNAMODB__ENDPOINT_URL=http://localhost:8000
DOCINTEL_DYNAMODB__REGION=us-east-1
DOCINTEL_DYNAMODB__ACCESS_KEY_ID=local
DOCINTEL_DYNAMODB__SECRET_ACCESS_KEY=local
DOCINTEL_DYNAMODB__TIMEOUT_S=5
DOCINTEL_DYNAMODB__MAX_RETRIES=3
DOCINTEL_DYNAMODB__CREATE_TABLES=true

DOCINTEL_OCCURRENCES__TABLE=docintel-occurrences
DOCINTEL_OCCURRENCES__BATCH_MAX_ATTEMPTS=5
DOCINTEL_OCCURRENCES__BATCH_BACKOFF_S=0.05

DOCINTEL_JOBS__MAX_ATTEMPTS=3
DOCINTEL_JOBS__DYNAMODB_TABLE=docintel-jobs

DOCINTEL_CPU__MAX_CONCURRENCY=2

# LEVEL: DEBUG | INFO | WARNING | ERROR
DOCINTEL_LOGGING__LEVEL=INFO
DOCINTEL_LOGGING__JSON_OUTPUT=true

# Offline evaluation (invoke eval).
DOCINTEL_EVAL__JUDGE_MODEL=us.anthropic.claude-sonnet-4-6
DOCINTEL_EVAL__RUNS=3
DOCINTEL_EVAL__CONCURRENCY=4
DOCINTEL_EVAL__MAX_JUDGE_CALLS=1500
DOCINTEL_EVAL__REPORT_DIR=.cache/eval/reports
DOCINTEL_EVAL__QUESTION_SETS=["samples","reworded"]
DOCINTEL_EVAL__SPLIT=all
DOCINTEL_EVAL__REQUESTS_PER_MINUTE=
