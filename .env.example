# Copy to .env to override the Docker Compose defaults.
APP_PORT=8000
# React frontend is bound to 127.0.0.1 on this host port.
FRONTEND_PORT=3000
APP_ENV=development
LOG_LEVEL=INFO
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
INGEST_COLLECTION=documents_minilm_1110a243_v1
EMBEDDING_QUERY_MAX_TOKENS=256
EMBEDDING_BATCH_SIZE=16
EMBEDDING_JOB_TIMEOUT_SECONDS=120
INGEST_MAX_IN_FLIGHT=1
INGEST_UPLOAD_TIMEOUT_SECONDS=30
INGEST_JOB_TIMEOUT_SECONDS=420
INGEST_MAX_CHUNKS=1000
INGEST_MAX_PAGE_CHARS=100000
INGEST_MAX_DOCUMENT_CHARS=1000000
INGEST_CHUNK_TOKENS=128
INGEST_OVERLAP_TOKENS=32
QDRANT_TIMEOUT_SECONDS=10
QDRANT_READ_RETRIES=2
QDRANT_BATCH_SIZE=64
# Maximum candidates considered by question retrieval.
ASK_MAX_CANDIDATES=100
ASK_MAX_REQUEST_BYTES=16384
ASK_MAX_IN_FLIGHT=2
ASK_UPLOAD_TIMEOUT_SECONDS=10
ASK_JOB_TIMEOUT_SECONDS=120
# Optional answer generation: disabled, gemini, or openai.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
# Explicitly opt in before sending document text to Gemini or OpenAI.
LLM_ALLOW_EXTERNAL=false
# Trusted HTTPS endpoint only; the API key is sent to this host for OpenAI mode.
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=512
# A retry can consume extra provider quota or be billed even if an earlier call failed.
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.25
MAX_UPLOAD_BYTES=20971520
# Complete /api/extract multipart body, including fields and headers.
MAX_REQUEST_BYTES=22020096
# UTF-8 size of the decoded names field, before JSON parsing.
MAX_NAMES_BYTES=65536
MAX_NAMES_COUNT=1000
MAX_NAME_CHARS=512
FUZZY_THRESHOLD=0.90
EXTRACT_MAX_IN_FLIGHT=2
EXTRACT_UPLOAD_TIMEOUT_SECONDS=30
# Compose enables temporary, single-operator previews using an internally generated secret.
# Set false to disable stages. Standalone backend deployments must provide their own token.
EXTRACT_PREVIEW_ENABLED=true
EXTRACT_PREVIEW_TOKEN=
MAX_EXTRACTED_NAMES=1000
MAX_FUZZY_COMPARISONS=100000
MAX_FUZZY_WORK_UNITS=100000000
# The default model is installed during dependency sync/image build.
NER_MODEL=en_core_web_sm
# 0 disables recovery; 1 exact, 2 conservative fuzzy, 3 OCR segmentation.
NER_NAME_RECOVERY_PASSES=1
NER_MAX_PAGE_CHARS=100000
NER_MAX_DOCUMENT_CHARS=1000000
NER_MAX_CONCURRENT_JOBS=1
NER_MAX_QUEUED_JOBS=1
NER_QUEUE_TIMEOUT_SECONDS=10
NER_JOB_TIMEOUT_SECONDS=60
NER_SHUTDOWN_TIMEOUT_SECONDS=10
MAX_PDF_PAGES=100
MAX_PAGE_PIXELS=20000000
OCR_DPI=200
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=60
OCR_MAX_CONCURRENT_JOBS=2
OCR_MAX_QUEUED_JOBS=2
OCR_QUEUE_TIMEOUT_SECONDS=10
OCR_UPLOAD_TIMEOUT_SECONDS=30
OCR_DOCUMENT_TIMEOUT_SECONDS=180
OCR_SHUTDOWN_TIMEOUT_SECONDS=10
OCR_ORIENTATION_MIN_CONFIDENCE=80
