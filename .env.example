# Copy to .env. Every value has a default in app/core/config.py; only override what you need.

# LLM: any OpenAI-compatible /chat/completions endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=3
# Extra JSON merged into every request. Self-hosted Qwen3 on vLLM needs this or it
# writes its reasoning into the answer:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# OCR / NER
OCR_DPI=300
OCR_LANGUAGES=eng
NER_MODEL=en_core_web_sm

# Matching
FUZZY_THRESHOLD=0.90
BBOX_TOKEN_THRESHOLD=0.80

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
CHROMA_DIR=./chroma_data

# Limits
MAX_UPLOAD_MB=20
MAX_PAGES=50
LOG_LEVEL=INFO
