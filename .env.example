# Copy to `.env` and adjust. Every key is optional; defaults live in app/config.py.
# Tesseract itself must be installed and on PATH (`tesseract --version`).

# OCR
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=3
OCR_TIMEOUT_S=30
BBOX_ORIGIN=top-left

# Upload limits
MAX_UPLOAD_MB=20
MAX_PAGES=50

# NER (spaCy model; drop all-caps names such as JOHN SMITH)
NER_MODEL=en_core_web_sm
NER_DROP_ALL_CAPS=true

# Embeddings ("cuda" needs a CUDA build of torch)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# RAG (chunk sizes in characters; keep CHUNK_OVERLAP < CHUNK_SIZE)
CHUNK_SIZE=500
CHUNK_OVERLAP=60
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=documents
TOP_K=5
MIN_SCORE=0.20

# LLM (OpenAI-compatible endpoint; timeouts in seconds; empty key for local Ollama)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_TIMEOUT_S=60
LLM_CONNECT_TIMEOUT_S=5
LLM_MAX_TOKENS=150
LLM_MAX_ATTEMPTS=3
LLM_RETRY_MAX_WAIT_S=8

# Fuzzy matching (0..1)
FUZZY_THRESHOLD=0.90
