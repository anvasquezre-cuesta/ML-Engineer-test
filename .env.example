# Document Intelligence Service — configuration.
# Copy to `.env` (git-ignored) and adjust. Every key is optional; defaults shown.

# Log level: DEBUG | INFO | WARNING | ERROR
DOCINTEL_LOG_LEVEL=INFO

# Largest accepted upload, in bytes (default 20 MB)
DOCINTEL_MAX_UPLOAD_BYTES=20971520

# Largest accepted PDF, in pages
DOCINTEL_MAX_PAGES=50

# DPI used to render each page before OCR (72..600); boxes are converted back to PDF points
DOCINTEL_RENDER_DPI=300

# Tesseract language codes, `+`-separated (e.g. eng+spa); the traineddata must be installed
DOCINTEL_OCR_LANGUAGES=eng

# OCR words with confidence below this (0..100) are dropped
DOCINTEL_OCR_CONFIDENCE_FLOOR=30.0

# Max seconds Tesseract may spend on one page
DOCINTEL_OCR_TIMEOUT_SECONDS=60.0

# Path to the Tesseract binary; leave unset to use `tesseract` from PATH.
# Windows example: DOCINTEL_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# DOCINTEL_TESSERACT_CMD=

# spaCy model used for PERSON recognition (installed as a pinned wheel in pyproject.toml).
# en_core_web_lg won spike S1 (ADR-013); any other model must be installed first.
DOCINTEL_NER_MODEL=en_core_web_lg

# Minimum similarity (0..1) for a fuzzy name match to be reported
DOCINTEL_FUZZY_THRESHOLD=0.90

# --- RAG ---
# Sentence-transformers embedding model (ADR-009); e5 needs its query:/passage: prefixes,
# applied inside the adapter. Downloaded to the Hugging Face cache on first start.
DOCINTEL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Max chunk size in embedder tokens (1..511 — e5 ignores anything past 512) (ADR-015)
DOCINTEL_CHUNK_MAX_TOKENS=250

# Folder of the embedded Chroma vector store, and its collection name (ADR-008)
DOCINTEL_VECTOR_STORE_PATH=.chroma
DOCINTEL_VECTOR_STORE_COLLECTION=chunks

# Cross-encoder that reranks the retrieval candidates (ADR-014). The default is the
# multilingual model that fits the CPU latency budget (spike S6); BAAI/bge-reranker-v2-m3
# is stronger but ~10x slower on CPU.
DOCINTEL_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Retrieval (ADR-014): candidates taken from each search (dense and BM25) and chunks sent
# to the LLM. There is no score cut-off: the LLM answers "not found" when the passages
# don't contain the answer (CR-002).
DOCINTEL_RETRIEVAL_CANDIDATES=10
DOCINTEL_TOP_K=5

# LLM for /api/ask: any OpenAI-compatible endpoint (ADR-010). Groq by default — create a
# free key at https://console.groq.com/keys. Without a key the service still starts;
# /api/ask answers 503 llm_not_configured whenever it would need the LLM.
DOCINTEL_LLM_BASE_URL=https://api.groq.com/openai/v1
# DOCINTEL_LLM_API_KEY=
DOCINTEL_LLM_MODEL=openai/gpt-oss-120b
# Per-call timeout (s) and retries with exponential backoff on 408/409/429/5xx
DOCINTEL_LLM_TIMEOUT_SECONDS=30
DOCINTEL_LLM_MAX_RETRIES=2
